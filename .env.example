APP_NAME=Quant OS
ENV=dev
MARKET_MODE=simulator
LIVE_VENUES=binance,coinbase
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SIM_TICK_MS=250
SIM_ARBITRAGE_PROBABILITY=0.08

DATABASE_URL=postgresql+asyncpg://quant:quant@postgres:5432/quant
API_CORS_ORIGINS=http://localhost:3000

INITIAL_CASH=100000
PAPER_AUTO_EXECUTE=true
PAPER_ORDER_NOTIONAL=1000

MIN_NET_EDGE_BPS=8
MAX_ORDER_NOTIONAL=2500
MAX_SYMBOL_EXPOSURE=15000
MAX_VENUE_EXPOSURE=30000
MAX_DAILY_LOSS=3000
MAX_DRAWDOWN_PCT=5
MAX_SLIPPAGE_BPS=15
CIRCUIT_BREAKER_REJECTIONS=25

BINANCE_TAKER_FEE_BPS=10
COINBASE_TAKER_FEE_BPS=12
SIM_A_TAKER_FEE_BPS=5
SIM_B_TAKER_FEE_BPS=5
DEFAULT_SLIPPAGE_BPS=2

ENABLE_LIVE_TRADING=false
LIVE_TRADING_ACK=
LOG_LEVEL=INFO
